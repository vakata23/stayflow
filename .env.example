# Копирайте този файл като .env и попълнете стойностите от
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Само за НАТИВНИЯ (Capacitor) билд — публичният уеб адрес на приложението.
# Оставете празно за уеб/Netlify билда. За нативния билд задайте реалния
# домейн, за да сочат гост линковете и iCal адресите към него.
# VITE_PUBLIC_URL=https://вашия-сайт.netlify.app

# САМО за сървърната функция /api/booking-request (netlify/functions/).
# БЕЗ VITE_ префикс нарочно — Vite НИКОГА не пакетира такива променливи в
# клиентския код, затова ключът не може да изтече през браузъра.
# Вземете го от Supabase Dashboard → Project Settings → API → service_role
# (НЕ anon!). В production се задава в Netlify → Site configuration →
# Environment variables — не тук.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# САМО за сървърните функции /api/process-outbox и /api/telegram-webhook —
# доставка на известия (Етап 5). Без тях outbox редовете остават "queued"
# и last_error обяснява кое липсва; нищо друго в приложението не се чупи.
#
# Telegram: създайте бот през @BotFather в Telegram → копирайте токена.
# TELEGRAM_WEBHOOK_SECRET: произволен дълъг низ, вие го измисляте (напр.
# `openssl rand -hex 24`) — Telegram го връща непроменен при всяка истинска
# доставка, за да различим истински POST от чужд/фалшив.
# След деплой пуснете ЕДНОКРАТНО (за да проработи self-discovery бутона
# в /notifications), с подадени И ДВЕТЕ стойности:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://вашия-сайт.netlify.app/api/telegram-webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
#
# Имейл: resend.com, безплатен тариф. "From" трябва да е на верифициран
# домейн в Resend (не произволен адрес).
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=StayFlow <notifications@вашия-домейн.bg>

# НЕ Е НУЖЕН СЕГА. Страницата за гости се прави без платено API (етикети на
# снимки + шаблонно описание). Тази променлива е само за бъдещия „AI
# асистент“ (properties.ai_assistant, изключен по подразбиране) — без нея
# /api/analyze-photos отказва и не харчи нищо.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Публично (безопасно в браузъра) — username на Telegram бота, само за да
# покажем директен t.me/ линк в /notifications. По избор.
# VITE_TELEGRAM_BOT_USERNAME=your_bot_username
